<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Private Flood Shield - ระบบเตือนภัยส่วนตัว</title>
    <link href="https://unpkg.com/maplibre-gl@4/dist/maplibre-gl.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body { margin: 0; font-family: 'Sarabun', sans-serif; background: #f0f2f5; }
        #map { height: 50vh; width: 100%; }
        .panel { padding: 16px; background: #fff; border-radius: 20px 20px 0 0; margin-top: -20px; position: relative; box-shadow: 0 -4px 15px rgba(0,0,0,0.1); min-height: 40vh; }
        .badge { display: inline-block; padding: 6px 14px; border-radius: 99px; color: #fff; font-weight: 700; font-size: 14px; margin-bottom: 10px; }
        .card { background: #f8f9fa; border-radius: 12px; padding: 12px; margin: 8px 0; border-left: 4px solid #1565C0; font-size: 14px; }
        h2 { margin: 0 0 10px 0; font-size: 18px; color: #333; }
        ul { margin: 0; padding-left: 20px; font-size: 14px; color: #555; }
        li { margin-bottom: 4px; }
    </style>
</head>
<body>

<div id="map"></div>
<div class="panel" id="panel">
    <h2>🛡️ กำลังโหลดข้อมูลภัยพิบัติรอบตัว...</h2>
    <p>กรุณารอสักครู่ กำลังดึงพิกัดและข้อมูลระดับน้ำเรียลไทม์</p>
</div>

<script src="https://unpkg.com/maplibre-gl@4/dist/maplibre-gl.js"></script>
<script>
    // ตั้งค่าพิกัดบ้านของคุณ (ตัวอย่าง: บางเสาธง สมุทรปราการ)
    const MY_LAT = 13.6499812;
    const MY_LON = 100.7881746;

    const map = new maplibregl.Map({
        container: 'map',
        style: 'https://basemaps.cartocdn.com/gl/positron-gl-style/style.json',
        center: [MY_LON, MY_LAT],
        zoom: 12
    });

    // ปักหมุดบ้านของคุณ
    new maplibregl.Marker({color: '#D32F2F'})
        .setLngLat([MY_LON, MY_LAT])
        .setPopup(new maplibregl.Popup().setHTML('<b>📍 บ้านของฉัน</b>'))
        .addTo(map);

    async function loadData() {
        try {
            // ดึงข้อมูลระดับน้ำจาก ThaiWater API ตรงผ่านเว็บ (CORS เปิดให้ใช้งานสาธารณะ)
            const res = await fetch('https://api-v3.thaiwater.net/api/v1/thaiwater30/public/waterlevel_load');
            const json = await res.json();
            const stations = json.data || [];

            let nearbyHTML = '';
            let count = 0;

            stations.forEach(d => {
                const stn = d.station || {};
                const lat = stn.tele_station_lat;
                const lon = stn.tele_station_long;
                if (!lat || !lon) return;

                // คำนวณระยะทางคร่าวๆ เป็นกิโลเมตรจากบ้าน
                const dist = Math.sqrt(Math.pow(lat - MY_LAT, 2) + Math.pow(lon - MY_LON, 2)) * 111;
                
                if (dist <= 15 && count < 5) { // แสดงสถานีที่อยู่ในรัศมี 15 กม.
                    count++;
                    const name = (stn.tele_station_name || {}).th || 'สถานีวัดน้ำ';
                    const waterVal = d.waterlevel_msl || d.value || 'ไม่ระบุ';
                    
                    nearbyHTML += `<div class="card">
                        <b>📍 ${name}</b> (ห่าง ${dist.toFixed(1)} กม.)<br>
                        ระดับน้ำ: <b>${waterVal}</b> เมตร (รทก.)
                    </div>`;

                    // ปักหมุดสถานีลงแผนที่
                    new maplibregl.Marker({color: '#0277BD'})
                        .setLngLat([lon, lat])
                        .setPopup(new maplibregl.Popup().setHTML(`<b>${name}</b><br>ระดับน้ำ: ${waterVal} ม.`))
                        .addTo(map);
                }
            });

            document.getElementById('panel').innerHTML = `
                <span class="badge" style="background: #FF6F00;">ระดับเฝ้าระวัง (ระดับ 1)</span>
                <h2>พิกัดบ้านของคุณ (บางเสาธง)</h2>
                <ul>
                    <li>สถานะ: ปกติ ตรวจสอบความพร้อมรอบบ้าน</li>
                    <li>ชาร์จแบตสำรอง / พาวเวอร์แบงก์ให้เต็ม</li>
                    <li>ยกปลั๊กไฟและสิ่งของขึ้นที่สูง</li>
                </ul>
                <h3 style="margin-top:15px; font-size:16px;">🌊 สถานีวัดน้ำใกล้บ้าน (รัศมี 15 กม.)</h3>
                ${nearbyHTML || '<p>ไม่พบสถานีวัดน้ำในรัศมีใกล้เคียง</p>'}
            `;

        } catch (e) {
            document.getElementById('panel').innerHTML = `<h2>⚠️ ไม่สามารถโหลดข้อมูลได้</h2><p>กรุณาตรวจสอบอินเทอร์เน็ต</p>`;
        }
    }

    loadData();
</script>

</body>
</html>
